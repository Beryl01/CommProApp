{
  "info": {
    "name": "CommSkill Pro — API Tests",
    "_postman_id": "c5e7a3b1-2d4f-4e8a-9b6c-1a3d5f7e9b0c",
    "description": "Functional API tests for CommSkill Pro Netlify serverless functions.\n\nBefore running:\n  • Set the baseUrl collection variable (default: https://commproapp.netlify.app)\n  • Positive proxy tests call the live Claude API and consume tokens — use max_tokens: 10 to keep costs minimal.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://commproapp.netlify.app",
      "type": "string",
      "description": "Base URL of the deployed app"
    }
  ],
  "item": [
    {
      "name": "Claude Proxy — /.netlify/functions/proxy",
      "description": "Tests for the Claude AI proxy function. Forwards requests to the Anthropic API and returns the response verbatim.",
      "item": [
        {
          "name": "conversation message — 200 OK",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('response has content array', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.property('content').that.is.an('array');",
                  "  pm.expect(body.content.length).to.be.above(0);",
                  "});",
                  "",
                  "pm.test('content[0].text is a non-empty string', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.content[0]).to.have.property('text').that.is.a('string').and.not.empty;",
                  "});",
                  "",
                  "pm.test('response has role assistant', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.property('role', 'assistant');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"model\": \"claude-haiku-4-5-20251001\",\n  \"max_tokens\": 10,\n  \"system\": \"You are a workplace communication coach. Reply in 5 words or fewer.\",\n  \"messages\": [\n    { \"role\": \"user\", \"content\": \"Give me one tip.\" }\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/.netlify/functions/proxy",
              "host": ["{{baseUrl}}"],
              "path": [".netlify", "functions", "proxy"]
            }
          }
        },
